# Variabili d'ambiente server-side per la Vercel Serverless Function (api/token.js).
# NON usare il prefisso VITE_ — questi valori non devono mai essere esposti al browser.
# Per sviluppo locale: copiare in .env.local e compilare con i valori reali.
# Per produzione: impostare nel dashboard Vercel → Settings → Environment Variables.

SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
