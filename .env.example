VITE_SPOTIFY_CLIENT_ID=""

# IMPORTANTE: Spotify non accetta "localhost" come redirect URI.
# Usare l'indirizzo IP loopback esplicito: 127.0.0.1 (dev) o il dominio HTTPS (prod).
# Registrare lo stesso valore nel Spotify Developer Dashboard → Settings → Redirect URIs.
VITE_REDIRECT_URI="http://127.0.0.1:5173/callback"
